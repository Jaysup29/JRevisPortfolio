APP_NAME="Jay-ar Revis Portfolio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://jrevisportfolio.onrender.com

DB_CONNECTION=sqlite

SESSION_DRIVER=cookie
QUEUE_CONNECTION=sync
CACHE_STORE=file

LOG_CHANNEL=stderr
LOG_LEVEL=info

BCRYPT_ROUNDS=12

# Mail — contact form delivery via Gmail SMTP.
# Set MAIL_USERNAME / MAIL_PASSWORD / MAIL_FROM_ADDRESS as environment
# variables in Render (never commit real secrets to git).
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Jay-ar Revis Portfolio"
